{
  "name": "사진대지 자동생성",
  "short_name": "사진대지",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1d4e6f",
  "theme_color": "#1d4e6f",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  }
}
